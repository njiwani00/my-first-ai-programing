# Template. setup.bat / setup.sh copy this to .env if .env is missing.
# =====================================================================
#  RAG Classroom settings
# =====================================================================
#
#  >>> THE ONLY LINE YOU MUST CHANGE <<<
#  Replace  paste-your-openai-key-here  with your real OpenAI key.
#  It starts with "sk-". No quotes, no spaces around the "=".
#
OPENAI_API_KEY=paste-your-openai-key-here
#
# =====================================================================


# ---------- Which AI does what (already set up for OpenAI) ----------
# LLM_PROVIDER = who WRITES the answer
#   openai     -> OpenAI chat model (uses your key)
#   extractive -> no AI, copies the best sentences (free, offline)
LLM_PROVIDER=openai

# EMBEDDER = who UNDERSTANDS the question and finds matching text
#   openai -> OpenAI embeddings, understands meaning (uses your key)
#   tfidf  -> simple word matching (free, offline)
EMBEDDER=openai

# ANSWER_MODE = what happens when the documents DON'T contain the answer
#   hybrid -> answer from OpenAI's general knowledge, labelled "From general knowledge:"
#             (ask about your documents OR anything else, like ChatGPT)
#   strict -> say "I don't know based on the provided documents" (classic RAG)
ANSWER_MODE=hybrid

# To run 100% free without a key, change LLM_PROVIDER and EMBEDDER to:
#   LLM_PROVIDER=extractive
#   EMBEDDER=tfidf


# ---------- OpenAI models ----------
# If you get "API error 404 ... model", replace with a model listed at
# https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1


# ---------- Chunking ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---------- Retrieval ----------
TOP_K=3
MIN_SCORE=0.05

# ---------- Answer style ----------
TEMPERATURE=0.2
MAX_TOKENS=800


# ---------- Other providers (optional, not needed) ----------
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
